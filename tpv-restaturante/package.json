{
  "name": "tpv-restaturante",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=2048 next dev",
    "build": "next build",
    "build:core": "npm run build --workspace @tpv/core",
    "start": "next start",
    "lint": "eslint",
    "lint:any": "node scripts/check-any-baseline.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "analyze:bundles": "cross-env ANALYZE=true next build",
    "test:e2e": "playwright test",
    "db:pull": "drizzle-kit pull",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "attw": "attw",
    "type-coverage": "type-coverage",
    "contract:test": "pact-test",
    "mutation:test": "stryker run",
    "bundle:check": "next build && size-limit"
  },
  "typeCoverage": {
    "strict": true,
    "cache": true,
    "atLeast": 99,
    "ignoreFiles": [
      "**/*.test.ts",
      "**/*.spec.ts",
      "coverage/**",
      ".next/**"
    ]
  },
  "dependencies": {
    "@sentry/nextjs": "^10.68.0",
    "@stripe/react-stripe-js": "3.3.0",
    "@stripe/stripe-js": "5.6.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/postcss": "^4",
    "@tpv/core": "*",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.7.3",
    "jose": "^6.2.7",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.21.0",
    "next": "^16.3.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.0",
    "stripe": "^17.7.0",
    "tailwindcss": "^4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.0",
    "@playwright/test": "^1.62.0",
    "@size-limit/file": "^13.0.3",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "size-limit": "^13.0.3",
    "type-coverage": "^2.30.1",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{test,spec}.{ts,tsx,js,jsx}": [
      "vitest related --run"
    ]
  }
}
