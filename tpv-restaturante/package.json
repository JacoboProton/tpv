{
  "name": "tpv-restaturante",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=4096 next dev",
    "build": "npm run build:core && npm run copy:core && next build",
    "build:core": "cd \"../packages/core\" && npm run build",
    "copy:core": "node scripts/copy-core.js",
    "start": "next start",
    "lint": "eslint",
    "lint:any": "node scripts/check-any-baseline.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:pull": "drizzle-kit pull",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "attw": "attw",
    "type-coverage": "type-coverage --strict --ignore-files '**/*.test.ts'",
    "contract:test": "pact-test",
    "mutation:test": "stryker run",
    "bundle:check": "size-limit --fail-on-error"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.68.0",
    "@stripe/react-stripe-js": "3.3.0",
    "@stripe/stripe-js": "5.6.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/postcss": "^4",
    "@tpv/core": "file:../packages/core",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "iconv-lite": "^0.7.3",
    "jose": "^6.2.7",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.21.0",
    "next": "^16.3.0",
    "nodemailer": "^9.0.3",
    "openai": "^6.45.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.0",
    "stripe": "^17.7.0",
    "tailwindcss": "^4",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^29.1.1",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
