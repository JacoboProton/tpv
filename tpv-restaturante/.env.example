# Base de datos (Supabase PostgreSQL)
# Pooler en modo transacción (para serverless)
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true
# Conexión directa (para migraciones — fallback si DATABASE_URL_POOLER no está definida)
DIRECT_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Supabase Realtime — sincronización KDS/POS en tiempo real
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=[YOUR-SUPABASE-PUBLISHABLE-KEY]

# Fiskaly — Verifactu (facturación electrónica AEAT)
FISKALY_ENVIRONMENT=TEST
FISKALY_API_KEY=[YOUR-FISKALY-API-KEY]
FISKALY_API_SECRET=[YOUR-FISKALY-API-SECRET]
FISKALY_TAXPAYER_NIF=[YOUR-NIF]
FISKALY_TERRITORY=CANARY_ISLANDS

# Stripe — pagos con tarjeta
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...  # Lo obtienes en dashboard.stripe.com → Webhooks
UBER_WEBHOOK_SECRET=             # Secreto del webhook de UberEats
GLOVO_WEBHOOK_SECRET=            # Secreto del webhook de Glovo

# Stripe Terminal — ubicación NFC (por defecto: La Comanda, Restaurante, Ciudad, ES, 28001)
STRIPE_LOCATION_NAME=Mi Restaurante
STRIPE_LOCATION_LINE1=Calle Mayor 1
STRIPE_LOCATION_CITY=Madrid
STRIPE_LOCATION_STATE=Madrid
STRIPE_LOCATION_COUNTRY=ES
STRIPE_LOCATION_POSTAL_CODE=28013

# JWT — firma y verificación de sesiones (obligatorio en producción)
# Opción A (HS256, recomendada): un secreto aleatorio largo
#   openssl rand -hex 32
JWT_SECRET=cambia_esto_por_un_secreto_aleatorio_largo
# Opción B (RS256): clave privada + pública PEM (jwt.ts usa RS256 si JWT_PRIVATE_KEY existe)
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...
# TTL de sesión en ms (por defecto 12h)
# JWT_TTL_MS=43200000

# API Key global heredada — solo se acepta como FALLBACK de transición en el proxy.
# La gestión real de claves por cliente (pos/kds/mobile) es vía tabla api_keys + /api/api-keys.
TPV_API_KEY=cambia_esto_por_una_clave_segura_aleatoria_larga
# El cliente web/KDS envía su clave en x-tpv-key (debe crearse en /api/api-keys como tipo 'pos'/'kds').
NEXT_PUBLIC_TPV_API_KEY=cambia_esto_por_la_clave_pos_del_cliente

# CORS — origenes permitidos para llamadas a /api/*
# Lista separada por comas. Usar * para permitir cualquier origen (solo desarrollo).
# Ejemplo: https://tudominio.com,https://admin.tudominio.com
ALLOWED_ORIGINS=*

# Sentry — monitoreo de errores (DSN público, seguro en cliente)
# Obtén un DSN en https://sentry.io → Projects → tu proyecto → Client Keys
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN= — token para subir sourcemaps en build (crea releases con stacktraces legibles)
# SENTRY_SOURCEMAPS=disable — desactiva el upload de sourcemaps (por defecto activo)

# Upstash Redis — rate limiter compartido (requerido si hay más de una réplica)
# Crea un banco de datos Redis gratis en https://console.upstash.com
# Si no se configura, el rate limiter cae a memoria local (válido para dev single-replica).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CRON — secreto para backup automático
# Debe ser una cadena aleatoria segura (ej: openssl rand -hex 32). El endpoint falla si no está definida.
CRON_SECRET=

# SMTP — envío de facturas por email
# Opción A: Gmail (requiere contraseña de aplicación en https://myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
#
# Opción B: SendGrid (recomendado, 1000 emails/mes gratis)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxxxx_tu_api_key

# Opcional: usar Supabase pooler/session pooler para entornos serverless
# Puedes definir DATABASE_URL_POOLER apuntando al pooler en el puerto 6543
# Por ejemplo: postgresql://user:password@ep-xxxx.supabase.co:6543/dbname?sslmode=require
# Alternativamente, solo configura DB_POOLER_PORT=6543 y la app intentará reemplazar el puerto
DATABASE_URL_POOLER=
DB_POOLER_PORT=6543
DB_POOL_MAX=20
# Ajustes de tiempo (ms)
DB_POOL_IDLE_MS=10000
DB_CONN_TIMEOUT_MS=5000
